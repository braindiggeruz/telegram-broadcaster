# Only build inputs enter the context. Runtime secrets, local data and internal
# audit/recovery documents must never enter an image layer or remote builder.
**
!package.json
!pnpm-lock.yaml
!patches/
!patches/**
!client/
!client/**
!shared/
!shared/**
!server/
!server/**
!drizzle/
!drizzle/0000_massive_chamber.sql
!migrations/
!migrations/*.sql
!scripts/
!scripts/build-server.mjs
!scripts/migrate.ts
!scripts/run.mjs
!scripts/container-entrypoint.sh
!vite.config.ts
!tsconfig.json
!Dockerfile
!.dockerignore

# Defense in depth if a sensitive or generated file is placed under source.
**/.env*
**/.runtime/**
**/.git/**
**/node_modules/**
**/__tests__/**
**/__fixtures__/**
**/fixtures/**
**/test-results/**
**/playwright-report/**
**/*.test.*
**/*.spec.*
**/*.log
**/*.pid
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tgbak
**/*.dump
**/*.bak
**/*.sql.gz
