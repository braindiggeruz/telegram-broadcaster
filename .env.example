# Generate private local values: node scripts/setup-local.mjs
NODE_ENV=production
HOST=127.0.0.1
PORT=3037
APP_ORIGIN=http://127.0.0.1:3037
DATABASE_URL=postgresql://user:password@127.0.0.1:54329/tgsender
DATABASE_SSL=disable
# Remote PostgreSQL requires verified TLS; DATABASE_CA can contain a trusted PEM.
DATABASE_CA=
# Node/Docker and backup use verified PostgreSQL TCP by default.
DATABASE_TRANSPORT=tcp
# Workers only: set DATABASE_TRANSPORT=supabase-relay and supply these bindings.
# Use exactly https://<20-letter-project-ref>.supabase.co/functions/v1/tg-postgres-relay
# with no query, fragment, explicit port, or redirect.
DATABASE_RELAY_URL=
# 43-character base64url HMAC-SHA256 token; never the service role key.
DATABASE_RELAY_TOKEN=
# Legacy anon JWT for the same Supabase project; no service_role JWT here.
DATABASE_RELAY_ANON_KEY=
OWNER_OPEN_ID=local-owner
OWNER_PASSWORD_HASH=
SESSION_SECRET=
ENCRYPTION_KEY=
BACKUP_KEY_BASE64=
LIVE_SEND_ENABLED=false
CONTACT_MIN_INTERVAL_SECONDS=86400
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_WEBHOOK_SECRET=
